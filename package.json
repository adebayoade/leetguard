{
  "name": "leetguard",
  "version": "1.3.2",
  "description": "LeetGuard - Security Anti-Pattern Scanner for Node.js and React projects",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "leetguard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint . && npx tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "security",
    "scanner",
    "vulnerability",
    "cve",
    "osv",
    "ISO 27001",
    "abandoned-packages",
    "ast-parser",
    "leetguard"
  ],
  "author": "Adebayo Aderibigbe",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "cvss": "^1.0.5",
    "cvss-calculator": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.8"
  }
}
